<!--
  Generated by `cargo wix init` and then hand-edited for the product name,
  description, icon, and the second (console) binary. The GUIDs below were
  generated once for VaultPony and are committed: the UpgradeCode in particular
  must never change, or a later installer cannot see and replace a prior install
  and both sit side by side. ProductCode is Id='*', regenerated per version by
  design.

  cargo-wix pre-processor variables available in this template:
    TargetTriple, TargetEnv, TargetVendor, CargoTargetBinDir, CargoTargetDir,
    CargoProfile, Version.
-->

<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='VaultPony'
        UpgradeCode='BC64DF8B-B9EE-4DF7-9BEC-9E466B2A3510'
        Manufacturer='NorseHorse'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='VaultPony Desktop - open and edit VeraCrypt-compatible encrypted containers'
            Manufacturer='NorseHorse'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='vaultpony-desktop Installation'/>

        <!--
          Remember where the app was installed, so a major upgrade reuses the
          same directory instead of forgetting a custom location and reinstalling
          to the default (which then removes the old one). On a first install
          there is no key, so APPLICATIONFOLDER keeps its default below. Written
          by the RememberInstallDir component further down.
        -->
        <Property Id='APPLICATIONFOLDER'>
            <RegistrySearch Id='PriorInstallDir' Root='HKLM'
                Key='Software\NorseHorse\VaultPony' Name='InstallDir' Type='raw'/>
        </Property>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='VaultPony'>
                    <Component Id='License' Guid='*'>
                        <File Id='LicenseFile'
                            DiskId='1'
                            Source='$(sys.SOURCEFILEDIR)License.rtf'
                            KeyPath='yes'/>
                    </Component>

                    <Component Id='RememberInstallDir' Guid='017CE113-336D-45B1-BF0A-848420C95174'>
                        <RegistryValue Root='HKLM'
                            Key='Software\NorseHorse\VaultPony'
                            Name='InstallDir'
                            Type='string'
                            Value='[APPLICATIONFOLDER]'
                            KeyPath='yes'/>
                    </Component>

                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='AB0B4517-FC1D-449F-9B42-9DA6D4321C85' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='vaultpony.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\vaultpony.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='exe1'
                                Name='vaultpony-cli.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\vaultpony-cli.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>
            <ComponentRef Id='License'/>
            <ComponentRef Id='RememberInstallDir'/>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <Icon Id='ProductICO' SourceFile='$(sys.SOURCEFILEDIR)Product.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
        </UI>

        <WixVariable Id='WixUILicenseRtf' Value='$(sys.SOURCEFILEDIR)License.rtf'/>

    </Product>

</Wix>
